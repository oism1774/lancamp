---
/** Pixel star field with twinkling plus-shaped stars and three shooting stars. */
import { STARS, STAR_COLORS, TWINKLES, SHOOTERS } from '../data/stars';

// Shooting-star tail: a 4px head followed by fading 3px pixels up and to the right.
const tail = Array.from({ length: 8 }, (_, i) => ({
  left: 6 * (i + 1),
  top: -3 * (i + 1),
  opacity: (0.89 - 0.11 * i).toFixed(2),
}));
---

<div class="sky" aria-hidden="true">
  {STARS.map(([left, top, size, color, opacity]) => (
    <i
      class="star"
      style={`left:${left}%;top:${top}%;width:${size}px;height:${size}px;background:${STAR_COLORS[color]};opacity:${opacity}`}
    />
  ))}
  {TWINKLES.map(([left, top, delay, color]) => (
    <i
      class="twinkle"
      style={`left:${left}%;top:${top}%;animation-delay:${delay}s;--c:${STAR_COLORS[color]}`}
    />
  ))}
  {SHOOTERS.map(([left, top, delay]) => (
    <i class="shooter" style={`left:${left}%;top:${top}%;animation-delay:${delay}s`}>
      <b class="head" />
      {tail.map((t) => (
        <b style={`left:${t.left}px;top:${t.top}px;opacity:${t.opacity}`} />
      ))}
    </i>
  ))}
</div>

<style>
  .sky {
    position: absolute;
    inset: 0 0 auto 0;
    height: var(--sky-h, 100%);
    pointer-events: none;
  }

  i, b {
    position: absolute;
    display: block;
  }

  /* Plus shape: a 3x9 bar and a 9x3 bar. */
  .twinkle {
    width: 9px;
    height: 9px;
    background:
      linear-gradient(var(--c), var(--c)) 3px 0 / 3px 9px no-repeat,
      linear-gradient(var(--c), var(--c)) 0 3px / 9px 3px no-repeat;
    animation: twinkle 2.6s steps(3) infinite;
  }

  .shooter {
    width: 60px;
    height: 4px;
    opacity: 0;
    animation: shoot 10s steps(24) infinite;
  }
  .shooter b {
    width: 3px;
    height: 3px;
    background: #ffe2c0;
  }
  .shooter .head {
    left: 0;
    top: 0;
    width: 4px;
    height: 4px;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }

  @keyframes shoot {
    0% { transform: translate(0, 0); opacity: 0; }
    2% { opacity: 1; }
    10% { transform: translate(-360px, 180px); opacity: 0; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .twinkle { animation: none; }
    .shooter { animation: none; display: none; }
  }
</style>
